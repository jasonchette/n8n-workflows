    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text || ($input.first().json.content && $input.first().json.content[0] && $input.first().json.content[0].text) || '';\nlet articles = [];\ntry {\n  const cleaned = raw.replace(/^```json\\s*/, '').replace(/```\\s*$/, '').trim();\n  articles = JSON.parse(cleaned);\n} catch(e) {\n  throw new Error('Failed to parse Claude response: ' + raw.slice(0, 200));\n}\nconst sections = {\n  TOP_STORY:      { label: '\\uD83D\\uDD25 Top Story',           color: '#E8F4FD', border: '#0070D2', items: [] },\n  ECOSYSTEM_NEWS: { label: '\\uD83D\\uDCF0 Ecosystem News',       color: '#FFF3E0', border: '#FF6B35', items: [] },\n  ADMIN_DEV:      { label: '\\u2699\\uFE0F Admin & Dev Picks',    color: '#E8F5E9', border: '#4CAF50', items: [] },\n  APPEXCHANGE:    { label: '\\uD83D\\uDCE6 AppExchange Watch',    color: '#F3E5F5', border: '#9C27B0', items: [] },\n  COMMUNITY:      { label: '\\uD83D\\uDCAC Community Spotlight',  color: '#FFF8E1', border: '#FFC107', items: [] }\n};\nfor (const a of articles) {\n  if (sections[a.section]) sections[a.section].items.push(a);\n}\nconst months = ['January','February','March','April','May','June','July','August','September','October','November','December'];\nconst days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];\nconst now = new Date();\nconst today = days[now.getDay()] + ', ' + months[now.getMonth()] + ' ' + now.getDate() + ', ' + now.getFullYear();\nconst subject = 'The Force Feed \\u00B7 ' + today;\nlet html = '<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><title>' + subject + '</title></head><body style=\"font-family:sans-serif;max-width:680px;margin:0 auto;padding:20px;background:#f5f5f5;\"><div style=\"background:#0070D2;color:white;padding:30px;border-radius:8px 8px 0 0;text-align:center;\"><h1 style=\"margin:0;font-size:28px;\">\\u26A1 The Force Feed</h1><p style=\"margin:8px 0 0;opacity:0.9;font-size:14px;\">' + today + ' \\u00B7 Your daily Salesforce briefing</p></div><div style=\"background:white;padding:20px;border-radius:0 0 8px 8px;\">';\nfor (const key of Object.keys(sections)) {\n  const sec = sections[key];\n  if (sec.items.length === 0) continue;\n  html += '<div style=\"margin-bottom:30px;\"><h2 style=\"color:' + sec.border + ';border-left:4px solid ' + sec.border + ';padding-left:12px;margin-bottom:16px;\">' + sec.label + '</h2>';\n  for (const a of sec.items) {\n    html += '<div style=\"background:' + sec.color + ';border:1px solid ' + sec.border + ';border-radius:6px;padding:16px;margin-bottom:12px;\"><h3 style=\"margin:0 0 8px;font-size:16px;\"><a href=\"' + a.url + '\" style=\"color:#0070D2;text-decoration:none;\">' + a.title + '</a></h3><p style=\"margin:0 0 8px;color:#444;line-height:1.5;font-size:14px;\">' + a.summary + '</p><p style=\"margin:0;font-size:12px;color:#888;\">\\uD83D\\uDCE1 ' + a.source + '</p></div>';\n  }\n  html += '</div>';\n}\nhtml += '</div><p style=\"text-align:center;font-size:12px;color:#999;margin-top:16px;\">The Force Feed \\u00B7 Automated Salesforce News Digest</p></body></html>';\nreturn [{ json: { html, subject, itemCount: articles.length } }];"
      },
