      "parameters": {
        "jsCode": "const items = $input.all();\nconst cutoff = Date.now() - 24 * 60 * 60 * 1000;\nconst seen = new Set();\nconst results = [];\nfor (const item of items) {\n  const j = item.json;\n  const title = (j.title || '').trim();\n  const url = (j.link || j.url || '').trim();\n  const pubDate = j.pubDate || j.isoDate || j.date || '';\n  const description = j.contentSnippet || j.content || j.description || j.summary || '';\n  const source = j.feedUrl || (j.meta && j.meta.title) || url;\n  if (!title || !url) continue;\n  const pub = pubDate ? new Date(pubDate).getTime() : Date.now();\n  if (pub < cutoff) continue;\n  const key = url || title.toLowerCase().slice(0, 60);\n  if (seen.has(key)) continue;\n  seen.add(key);\n  results.push({ json: { title, url, source, published: pubDate, description: description.slice(0, 400) } });\n}\nreturn results;"
      },
